+            !std::isfinite(width / res) || width <= 0 ||
+            numeric_limits<unsigned>::max() - 4.0 < width / res)
+          THROW("Invalid or unrepresentable global grid extent");
+      }
+      return Grid(bounds.grow(res * 0.9), res);
+    }
