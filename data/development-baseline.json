  "progression": [
    "S1 / S2 钻孔已有结果；S3 槽、台阶、轮廓和面铣共十六例通过，继续扩展铣孔和多工序。",
    "沿单孔 → 孔系 → 铣削特征 → 多工序 → 3+2 → 连续五轴推进。",
    "真实单件、新设备、新毛坯或材料按依赖接入，每次只改变一类条件。"
  ],
  "update_policy": {
    "baseline": "新增或改变起始条件时另建基线 ID，保留原基线与证据，再更新 active_baseline_id。",
    "capabilities": "每个条目独立更新状态、适用范围、阶段和结果链接；单例实测不自动升级为范围已验证。",
    "qualified_scope": "必须有独立正常/错误案例、明确参数/精度/资源范围和逐项验收证据。",
    "material_claims": "材料标签、几何去料与材料物理分别记录，不互相替代。"
  }
