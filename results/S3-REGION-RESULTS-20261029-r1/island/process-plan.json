      "name": "铣",
      "steps": [
        {
          "id": "OP10.1",
          "type": "setup",
          "text": "按确认后的定位基准与装夹方案找正；建立 CAD 与工件坐标的对应关系。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.1"
          }
        },
        {
          "id": "OP10.2",
          "type": "region_milling",
          "text": "按原 CAD 边界铣 P1 平面区域，深 0.5 mm、平底、侧壁垂直；X1–7、Y1–5 的圆角槽，R0.5；保留中心 (4,3)、半径 0.65 的圆形岛台至来料顶面。 按附件分层清除，保留全部岛台和侧壁。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.2"
          },
          "feature_id": "P1",
          "depends_on": [
            "OP05.1",
            "OP10.1"
          ],
          "constraints": {
            "depth_mm": 0.5,
            "bottom_shape": "flat",
            "tool_id": "T1"
          }
        }
      ]
    },
    {
      "id": "OP20",
      "name": "去毛刺",
      "steps": [
        {
          "id": "OP20.1",
          "type": "deburring",
          "text": "槽边与外缘去毛刺、锐边处理按制造要求确认；不自行增加倒角。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP20.1"
          }
        }
      ]
    },
    {
      "id": "OP30",
      "name": "检验",
      "steps": [
        {
          "id": "OP30.1",
          "type": "inspection",
          "text": "检查完整轮廓、切深与底厚；如有开口或岛台，分别检查外缘余料与岛台保留；制造公差与检验依据待确认。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP30.1"
          }
        }
      ]
    },
