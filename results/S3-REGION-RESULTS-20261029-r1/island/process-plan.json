  "operations": [
    {
      "id": "OP05",
      "name": "来料核对",
      "steps": [
        {
          "id": "OP05.1",
          "type": "incoming_inspection",
          "text": "核对来料外形、厚度、材料状态及版本；确认等大毛坯前提。",
          "source": {
            "document_id": "CARD",
            "page": 2,
