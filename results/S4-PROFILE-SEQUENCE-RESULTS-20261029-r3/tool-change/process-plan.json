  "operations": [
    {
      "id": "OP05",
      "name": "来料核对",
      "steps": [
        {
          "id": "OP05.1",
          "type": "incoming_inspection",
          "text": "核对 8 × 4 × 1.5 mm 完整矩形来料、6061-T6 材料标签、独立原 CAD 和版本。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP05.1"
          }
        }
      ]
    },
    {
      "id": "OP10",
      "name": "铣",
      "steps": [
        {
          "id": "OP10.1",
          "type": "setup",
          "text": "按确认后的定位基准与装夹方案找正；建立 CAD 与工件坐标的对应关系。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.1"
          }
        },
        {
          "id": "OP10.2",
          "type": "face_milling",
          "text": "用 T1 面铣 P1：由来料顶面 Z0 铣至 Z-0.5，厚度 1；保持底面及 XY 外形。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.2"
          },
          "feature_id": "P1",
          "depends_on": [
            "OP05.1",
            "OP10.1"
          ],
          "constraints": {
            "thickness_mm": 1.0,
            "top_shape": "flat",
            "tool_id": "T1"
          }
        },
        {
          "id": "OP10.3",
          "type": "external_profile_milling",
          "text": "用 T1 铣 C1 圆头外形：长 8、宽 4、端圆 R2，长轴 X，贯穿原底面并清除外侧余料。层内闭合后直接下层；孔不得被轮廓操作加工。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.3"
          },
          "feature_id": "C1",
          "depends_on": [
            "OP10.2"
          ],
          "constraints": {
            "length_mm": 8,
            "width_mm": 4,
            "thickness_mm": 1.0,
            "end_condition": "through_stock",
            "tool_id": "T1"
          }
        },
        {
          "id": "OP10.4",
          "type": "helical_hole_milling",
          "text": "用 T2 在当前剩料上螺旋铣 H1：孔心 (2, 2)，φ2 贯穿；中心不得留芯，沿用原 CAD 坐标。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.4"
          },
          "feature_id": "H1",
          "depends_on": [
            "OP10.3"
          ],
          "constraints": {
            "diameter_mm": 2,
            "end_condition": "through",
            "tool_id": "T2"
          }
        },
        {
          "id": "OP10.5",
          "type": "helical_hole_milling",
          "text": "用 T2 在当前剩料上螺旋铣 H2：孔心 (6, 2)，φ2 贯穿；中心不得留芯，沿用原 CAD 坐标。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.5"
          },
          "feature_id": "H2",
          "depends_on": [
            "OP10.4"
          ],
          "constraints": {
            "diameter_mm": 2,
            "end_condition": "through",
            "tool_id": "T2"
          }
        }
      ]
    },
    {
      "id": "OP20",
      "name": "去毛刺",
      "steps": [
        {
          "id": "OP20.1",
          "type": "deburring",
          "text": "孔口及外缘去毛刺、锐边处理按制造要求确认；不自行增加倒角。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP20.1"
          }
        }
      ]
    },
    {
      "id": "OP30",
      "name": "检验",
      "steps": [
        {
          "id": "OP30.1",
          "type": "inspection",
          "text": "检查面铣后的实际剩料，以及最终厚度、顶面、外缘和各孔；工步顺序、用刀亦须符合本卡。制造验收依据待确认。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP30.1"
          }
        }
      ]
    },
