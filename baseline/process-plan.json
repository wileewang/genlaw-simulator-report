          "constraints": {
            "width_mm": 0.4,
            "angle_degrees": 45,
            "edge_selection": "all_four_top_edges",
            "tool_id": "T1"
          }
        }
      ]
    },
    {
      "id": "OP20",
      "name": "去毛刺",
      "steps": [
        {
          "id": "OP20.1",
          "type": "deburring",
          "text": "检查倒角边缘毛刺；是否需人工去毛刺按实际工艺确认，不追加未经定义的倒角。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP20.1"
