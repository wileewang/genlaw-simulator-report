            "location": "工序 / 工步 OP10.1"
          }
        },
        {
          "id": "OP10.2",
          "type": "face_milling",
          "text": "用 T1 面铣 P1：由来料顶面 Z0 铣至 Z-1，厚度 2；保持底面及 XY 外形。",
          "source": {
            "document_id": "CARD",
            "page": 2,
            "location": "工序 / 工步 OP10.2"
