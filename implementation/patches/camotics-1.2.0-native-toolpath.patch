+    void writeToolpath(const GCode::ToolPath &gauge,
+                       const GCode::ToolPath &material) {
+      if (gauge.size() != material.size() || material.empty() ||
+          200000 < material.size())
+        THROW("Native path export requires 1 to 200000 complete moves");
+      ostream &out = *output;
+      out.imbue(std::locale::classic());
+      out << setprecision(numeric_limits<double>::max_digits10)
+          << "{\"schema\":\"genlaw.native-toolpath.v1\",\"units\":\"mm\","
+          << "\"frame\":\"original_cad_material_tip\","
+          << "\"nc_executed\":true,\"surface_computed\":false,"
+          << "\"native_max_arc_error_mm\":0.01,\"moves\":[";
+      for (unsigned i = 0; i < material.size(); ++i) {
+        const GCode::Move &m = material.at(i), &g = gauge.at(i);
+        out << (i ? "," : "") << "{\"index\":" << i
+            << ",\"line\":" << m.getLine() << ",\"tool_number\":" << m.getTool()
+            << ",\"type\":\"" << m.getType().toString() << "\",\"feed_mm_min\":"
+            << m.getFeed() << ",\"spindle_rpm\":" << m.getSpeed();
+        const char *keys[] = {"start_mm", "end_mm", "gauge_start_mm", "gauge_end_mm"};
+        const GCode::Axes *points[] = {&m.getStart(), &m.getEnd(), &g.getStart(), &g.getEnd()};
+        for (unsigned j = 0; j < 4; ++j) {
+          out << ",\"" << keys[j] << "\":[";
+          for (unsigned k = 0; k < 3; ++k)
+            out << (k ? "," : "") << points[j]->getIndex(k);
+          out << "]";
+        }
+        out << "}";
+      }
+      out << "]}" << endl;
+    }
